<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo dan nama aplikasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#0878D1"
                android:gravity="center"
                android:text="CC"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cyla Care"
                    android:textColor="#142D4E"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accessibility companion"
                    android:textColor="#718198"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Banner utama -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="32dp"
            android:background="#0878D1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="#D7F3EF"
                android:gravity="center"
                android:text="✦"
                android:textColor="#147D78"
                android:textSize="68sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Semua Bisa, Semua Terbantu"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Teknologi yang mendukung aktivitasmu setiap hari."
                android:textColor="#E8F8FF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Sambutan -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="Selamat datang di Cyla Care"
            android:textColor="#142D4E"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Asisten digital yang dirancang untuk membantu penyandang disabilitas mengakses informasi dan menjalani aktivitas dengan lebih mudah."
            android:textColor="#63748B"
            android:textSize="15sp" />

        <!-- Tombol mulai -->
        <TextView
            android:id="@+id/btnMulaiSekarang"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:background="#0878D1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Mulai Sekarang   →"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Ramah • Inklusif • Mudah Digunakan"
            android:textColor="#8795A8"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
