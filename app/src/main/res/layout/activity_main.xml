<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F8FC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CYLA CARE"
                        android:textColor="#147D78"
                        android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Halo, selamat datang!"
                        android:textColor="#142D4E"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Apa yang bisa kami bantu hari ini?"
                        android:textColor="#63748B"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_home_icon"
                    android:gravity="center"
                    android:text="CC"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:contentDescription="Logo Cyla Care" />
            </LinearLayout>

            <!-- BANNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_home_banner"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAHABAT AKSESIBILITAS"
                    android:textColor="#D8FFF5"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="Teknologi untuk semua."
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Peduli, terhubung, dan mandiri. Temukan bantuan digital yang memudahkan aktivitas sehari-hari."
                    android:textColor="#E8F8FF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- PENCARIAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_home_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="15dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="⌕"
                    android:textColor="#168C88"
                    android:textSize="27sp" />

                <EditText
                    android:id="@+id/etCari"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Cari fitur yang dibutuhkan..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="8dp"
                    android:singleLine="true"
                    android:textColor="#142D4E"
                    android:textColorHint="#8795A8"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- JUDUL FITUR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Fitur utama"
                android:textColor="#142D4E"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Pilih bantuan yang kamu perlukan."
                android:textColor="#63748B"
                android:textSize="13sp" />

            <!-- ASISTEN VISUAL -->
            <LinearLayout
                android:id="@+id/btnVisual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="112dp"
                android:orientation="horizontal"
                android:padding="17dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="#DCEBFF"
                    android:gravity="center"
                    android:text="OCR"
                    android:textColor="#1768C4"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Asisten Visual"
                        android:textColor="#142D4E"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Baca tulisan dari foto dan dokumen."
                        android:textColor="#63748B"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#168C88"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- DETEKSI OBJEK -->
            <LinearLayout
                android:id="@+id/btnDeteksiObjek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="112dp"
                android:orientation="horizontal"
                android:padding="17dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="#D8F5EA"
                    android:gravity="center"
                    android:text="AI"
                    android:textColor="#12845F"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Deteksi Objek AI"
                        android:textColor="#142D4E"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Kenali benda melalui gambar."
                        android:textColor="#63748B"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#168C88"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- MOBILITAS -->
            <Button
                android:id="@+id/btnMobilityAid"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:text="Alat Bantu Mobilitas"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#147D78"
                android:contentDescription="Buka fitur alat bantu mobilitas" />

            <!-- KOMUNIKASI -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="Komunikasi"
                android:textColor="#142D4E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnKomunikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="105dp"
                android:orientation="horizontal"
                android:padding="17dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="#D8F5EA"
                    android:gravity="center"
                    android:text="Aa"
                    android:textColor="#12845F"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Komunikasi Teks dan Suara"
                        android:textColor="#142D4E"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Bantu komunikasi melalui teks dan suara."
                        android:textColor="#63748B"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#168C88"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- BANTUAN LAINNYA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="Bantuan lainnya"
                android:textColor="#142D4E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal">

                <!-- AKSESIBILITAS -->
                <LinearLayout
                    android:id="@+id/btnAksesibilitas"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="#DCEBFF"
                        android:gravity="center"
                        android:text="⚙"
                        android:textColor="#1768C4"
                        android:textSize="23sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Aksesibilitas"
                        android:textColor="#142D4E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Pengaturan bantuan"
                        android:textColor="#63748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- BANTUAN DARURAT -->
                <LinearLayout
                    android:id="@+id/btnBantuan"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="#FFE7E4"
                        android:gravity="center"
                        android:text="!"
                        android:textColor="#D64E42"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Bantuan Darurat"
                        android:textColor="#142D4E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Akses bantuan"
                        android:textColor="#63748B"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- FOOTER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="Cyla Care • Teknologi yang lebih inklusif"
                android:textColor="#8795A8"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <!-- NAVIGASI BAWAH -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- BERANDA AKTIF -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#0878D1"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beranda"
                android:textColor="#0878D1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- LAYANAN -->
        <LinearLayout
            android:id="@+id/navLayanan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textColor="#526B80"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Layanan"
                android:textColor="#526B80"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- CATATAN -->
        <LinearLayout
            android:id="@+id/navCatatan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▤"
                android:textColor="#526B80"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catatan"
                android:textColor="#526B80"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- PROFIL -->
        <LinearLayout
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textColor="#526B80"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil"
                android:textColor="#526B80"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
