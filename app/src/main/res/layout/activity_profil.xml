<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profilMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F8FC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profil"
                android:textColor="#142D4E"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Pengaturan dan informasi aplikasi"
                android:textColor="#63748B"
                android:textSize="13sp" />

            <!-- PROFIL PENGGUNA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:background="@drawable/bg_home_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="CC"
                    android:textColor="#147D78"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pengguna Cyla Care"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Peduli, Terhubung, dan Mandiri"
                        android:textColor="#E8F8FF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- PENGATURAN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="Pengaturan Aplikasi"
                android:textColor="#142D4E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- AKSESIBILITAS -->
            <LinearLayout
                android:id="@+id/menuAksesibilitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="75dp"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#DCEBFF"
                    android:gravity="center"
                    android:text="♿"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Pengaturan Aksesibilitas"
                    android:textColor="#142D4E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#147D78"
                    android:textSize="25sp" />
            </LinearLayout>

            <!-- UKURAN TEKS -->
            <LinearLayout
                android:id="@+id/menuUkuranTeks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="75dp"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#E9E2FF"
                    android:gravity="center"
                    android:text="Aa"
                    android:textColor="#7252B5"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Ukuran Teks"
                    android:textColor="#142D4E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#147D78"
                    android:textSize="25sp" />
            </LinearLayout>

            <!-- SUARA -->
            <LinearLayout
                android:id="@+id/menuSuara"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="75dp"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#D8F5EA"
                    android:gravity="center"
                    android:text="♫"
                    android:textColor="#12845F"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Pengaturan Suara"
                    android:textColor="#142D4E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#147D78"
                    android:textSize="25sp" />
            </LinearLayout>

            <!-- NOTIFIKASI -->
            <LinearLayout
                android:id="@+id/menuNotifikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="75dp"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#FFF0D8"
                    android:gravity="center"
                    android:text="♧"
                    android:textColor="#B87920"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Notifikasi"
                    android:textColor="#142D4E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#147D78"
                    android:textSize="25sp" />
            </LinearLayout>

            <!-- BAHASA -->
            <LinearLayout
                android:id="@+id/menuBahasa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="75dp"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#DCEBFF"
                    android:gravity="center"
                    android:text="文"
                    android:textColor="#1768C4"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Bahasa Aplikasi"
                    android:textColor="#142D4E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#147D78"
                    android:textSize="25sp" />
            </LinearLayout>

            <!-- INFORMASI -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="Informasi"
                android:textColor="#142D4E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- TENTANG -->
            <LinearLayout
                android:id="@+id/menuTentang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="70dp"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#DCEBFF"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="#1768C4"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Tentang Cyla Care"
                    android:textColor="#142D4E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#147D78"
                    android:textSize="25sp" />
            </LinearLayout>

            <!-- PANDUAN -->
            <LinearLayout
                android:id="@+id/menuPanduan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="70dp"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#D8F5EA"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="#12845F"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Panduan Penggunaan"
                    android:textColor="#142D4E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#147D78"
                    android:textSize="25sp" />
            </LinearLayout>

            <!-- PRIVASI -->
            <LinearLayout
                android:id="@+id/menuPrivasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="70dp"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#E9E2FF"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#7252B5"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Privasi Aplikasi"
                    android:textColor="#142D4E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#147D78"
                    android:textSize="25sp" />
            </LinearLayout>

            <!-- KELUAR -->
            <Button
                android:id="@+id/btnKeluar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="27dp"
                android:layout_marginBottom="15dp"
                android:backgroundTint="#D94F4F"
                android:text="Keluar Aplikasi"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:gravity="center"
                android:text="Cyla Care • Teknologi yang lebih inklusif"
                android:textColor="#8795A8"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <!-- NAVIGASI BAWAH -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- BERANDA -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#526B80"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beranda"
                android:textColor="#526B80"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- LAYANAN -->
        <LinearLayout
            android:id="@+id/navLayanan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textColor="#526B80"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Layanan"
                android:textColor="#526B80"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- CATATAN -->
        <LinearLayout
            android:id="@+id/navCatatan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▤"
                android:textColor="#526B80"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catatan"
                android:textColor="#526B80"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- PROFIL AKTIF -->
        <LinearLayout
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textColor="#0878D1"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil"
                android:textColor="#0878D1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
