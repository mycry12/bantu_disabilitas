<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F4F8FC">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih jenis bantuan yang kamu butuhkan"
        android:textColor="#647B8D"
        android:textSize="13sp"
        android:layout_marginBottom="14dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/daruratUmum"
            style="@style/BantuanDaruratCard"
            android:layout_marginEnd="6dp">
            <TextView
                style="@style/BantuanDaruratIcon"
                android:text="🚨"/>
            <TextView
                style="@style/BantuanDaruratTitle"
                android:text="Darurat Umum"/>
            <TextView
                style="@style/BantuanDaruratNomor"
                android:text="112"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/daruratAmbulans"
            style="@style/BantuanDaruratCard"
            android:layout_marginStart="6dp">
            <TextView
                style="@style/BantuanDaruratIcon"
                android:text="🚑"/>
            <TextView
                style="@style/BantuanDaruratTitle"
                android:text="Ambulans"/>
            <TextView
                style="@style/BantuanDaruratNomor"
                android:text="119"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/daruratPolisi"
            style="@style/BantuanDaruratCard"
            android:layout_marginEnd="6dp">
            <TextView
                style="@style/BantuanDaruratIcon"
                android:text="👮"/>
            <TextView
                style="@style/BantuanDaruratTitle"
                android:text="Polisi"/>
            <TextView
                style="@style/BantuanDaruratNomor"
                android:text="110"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/daruratPemadam"
            style="@style/BantuanDaruratCard"
            android:layout_marginStart="6dp">
            <TextView
                style="@style/BantuanDaruratIcon"
                android:text="🚒"/>
            <TextView
                style="@style/BantuanDaruratTitle"
                android:text="Pemadam"/>
            <TextView
                style="@style/BantuanDaruratNomor"
                android:text="113"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/daruratSAR"
            style="@style/BantuanDaruratCard"
            android:layout_marginEnd="6dp">
            <TextView
                style="@style/BantuanDaruratIcon"
                android:text="🆘"/>
            <TextView
                style="@style/BantuanDaruratTitle"
                android:text="SAR"/>
            <TextView
                style="@style/BantuanDaruratNomor"
                android:text="115"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/daruratBNPB"
            style="@style/BantuanDaruratCard"
            android:layout_marginStart="6dp">
            <TextView
                style="@style/BantuanDaruratIcon"
                android:text="🌊"/>
            <TextView
                style="@style/BantuanDaruratTitle"
                android:text="BNPB"/>
            <TextView
                style="@style/BantuanDaruratNomor"
                android:text="117"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
