<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnKembaliKomunikasi"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹  Kembali"
            android:textColor="#147D78"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Komunikasi Teks &amp; Suara"
            android:textColor="#142D4E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sampaikan pesan dengan mengetik atau berbicara."
            android:textColor="#63748B"
            android:textSize="14sp" />

        <!-- Kartu informasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_home_banner"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Berkomunikasi tanpa batas"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ketik pesan untuk dibacakan dengan suara, atau gunakan mikrofon untuk mengubah ucapan menjadi teks."
                android:textColor="#E8F8FF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Input pesan -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tulis pesan"
            android:textColor="#142D4E"
            android:textSize="19sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPesan"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_search"
            android:gravity="top|start"
            android:hint="Ketik pesan yang ingin disampaikan..."
            android:inputType="textCapSentences|textMultiLine"
            android:padding="16dp"
            android:textColor="#142D4E"
            android:textColorHint="#8795A8"
            android:textSize="16sp" />

        <!-- Tombol utama -->
        <TextView
            android:id="@+id/btnBicara"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_home_banner"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▶  Bacakan Pesan"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDengarkan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🎙  Ubah Suara Menjadi Teks"
            android:textColor="#147D78"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnHapus"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Hapus teks"
                android:textColor="#D64E42"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnSalin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Salin teks"
                android:textColor="#1768C4"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Pesan cepat -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Pesan cepat"
            android:textColor="#142D4E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPesanBantu"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="🆘   Tolong bantu saya"
            android:textColor="#142D4E"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnPesanTerimaKasih"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="✓   Terima kasih"
            android:textColor="#142D4E"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnPesanTidakMengerti"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="maaf belum mengerti"
            android:textColor="#142D4E"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvHasilSuara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#E2F5EF"
            android:padding="16dp"
            android:text="Hasil pengenalan: belum ada suara yang diubah menjadi teks."
            android:textColor="#146B60"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Cyla Care • Komunikasi untuk semua"
            android:textColor="#8795A8"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
